# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/licence_sku_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# API Configuration
API_TITLE=License SKU Microservice
API_VERSION=v1
DEBUG=True
ENVIRONMENT=development

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
CLERK_PUBLISHABLE_KEY=your-clerk-key
CLERK_SECRET_KEY=your-clerk-secret

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=3600

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY=300

# Service URLs
CLERK_AUTH_SERVICE_URL=http://localhost:5173
VALIDATION_TOKEN_EXPIRY=86400

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
